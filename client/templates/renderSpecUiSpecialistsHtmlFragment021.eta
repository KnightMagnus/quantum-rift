<div class="ocard"><div class="oname"><img src="<%~ it.artworkUrl %>" style="width:64px;height:48px;object-fit:contain;float:left;margin-right:6px"><b><%= it.specialistShipName %></b> <span class="small" style="color:<%~ it.roleInfoColor %>"><%~ it.roleInfoIcon %> <%~ it.roleInfoName %></span><%~ it.savedSpecialist %><div class="dim small"><%= it.specialistShipSub %></div></div>
      <div class="small" style="clear:both"><%= it.specialistShipAbility %></div><div class="dim small">Loop: <%= it.specialistShipLoop %></div>
      <div class="kv"><span class="small"><%~ it.specialistShipKey %> Blueprints <%~ it.MathMin %>/<%~ it.BP_NEED %></span><span class="small"><%~ it.response %> · <%~ it.parts %> parts</span></div><div class="xpbar"><i style="width:<%~ it.MathMin2 %>%;background:#c9a24a"></i></div><%~ it.button %></div>