<div class="mcard"><b><%= it.title %> · <%= it.refineryBatchStatusToUpperCase %></b><div><%= it.STELLARS %> · <%~ it.refineryBatchQuoteUnits %>t · <span data-ref-time="<%~ it.refineryBatchReadyAt %>" data-ref-start="<%~ it.refineryBatchStartAt %>" data-ref-status="<%~ it.refineryBatchStatus %>"><%~ it.refineryBatchStatus2 %></span></div><%~ it.refineryBatchStatus3 %><%~ it.refineryBatchStatus4 %><button class="btn sm" data-plot="<%= it.STELLARS2 %>">PLOT PORT</button></div>