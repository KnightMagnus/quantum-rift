<div class="store-heading"><div class="faction-screen"><img id="faction-insignia" src="assets/factions/<%~ it.faction %>.svg" alt="<%= it.FACTIONS_ %> insignia" data-faction="<%~ it.faction2 %>" width="112" height="112"></div><h2>FACTION STORES <span class="dim small">Rift scrip: <%~ it.playerPayloadTokens %> · <%~ it.clientGameStateLanded %></span></h2></div><div class="sgrid"><div class="sfacs"><%~ it.side %></div><div class="sbody well"><%~ it.storeHtml %></div></div><button class="btn sm" data-act="sclose">CLOSE (Esc)</button>