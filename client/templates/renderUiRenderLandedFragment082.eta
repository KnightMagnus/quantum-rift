<div class="detail"><img src="<%~ it.artworkUrl %>"><div><b style="font-size:16px;color:#fff"><%= it.shipHullAssetName %></b> <span class="dim"><%= it.shipHullAssetSub %></span> <%~ it.roleTag %><%~ it.shipHullAssetCargo %><%~ it.statLines %>
