<div class="mission-filters"><label class="small"><%~ it.scope %> type <select data-mission-filter="<%~ it.scope2 %>Type" aria-label="<%~ it.scope3 %> type"><%~ it.kindsMap %></select></label><label class="small"><input type="checkbox" data-mission-filter="<%~ it.scope4 %>Feasible"<%~ it.clientGameState %>> <%~ it.scope5 %></label><label class="small"><input type="checkbox" data-mission-filter="<%~ it.scope6 %>Nearby"<%~ it.clientGameState2 %>> Within 1 jump</label></div>