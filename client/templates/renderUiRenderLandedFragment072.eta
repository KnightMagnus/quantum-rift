<tr class="small"><td>↳ <%~ it.grade %></td><td><%~ it.grade2 %>× raw sale value</td><td><%~ it.count %> t</td><td style="text-align:right"><button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId %>" data-grade="<%~ it.grade3 %>" data-q="-1">SELL 1</button> <button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId2 %>" data-grade="<%~ it.grade4 %>" data-q="<%~ it.count2 %>">SELL <%~ it.gradeToUpperCase %></button></td></tr>