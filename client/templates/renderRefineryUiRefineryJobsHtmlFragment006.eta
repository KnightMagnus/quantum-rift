<div class="mcard"><b>DELIVERY <%~ it.miningOrderQty %>t <%= it.miningOrderGrade %> <%= it.title %></b><p><%= it.STELLARS %> · <%~ it.miningOrderReward %>cr · Bring this grade before <%~ it.Date %></p><button class="btn sm" data-refinery="deliver" data-order="1" data-id="<%= it.miningOrderId %>" data-port="<%= it.miningOrderPort %>">DELIVER CARGO</button><button class="btn sm" data-refinery="cancelOrder" data-order="1" data-id="<%= it.miningOrderId2 %>" data-port="<%= it.miningOrderPort2 %>">CANCEL ORDER</button></div>