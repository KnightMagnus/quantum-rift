<div class="it" data-i="<%~ it.index %>" role="button" tabindex="0" aria-label="Play <%= it.radioStationName %>"><div class="n"><div><%= it.radioStationName2 %></div><div class="s"><%= it.radioStationSub %></div></div><span class="star" role="button" tabindex="0" aria-label="Favorite <%= it.radioStationName3 %>" data-star="<%~ it.index2 %>" style="color:<%~ it.favoritesSome %>;font-size:15px">★</span></div>