<div style="display:flex;gap:10px;align-items:center"><img src="<%~ it.artworkUrl %>" style="width:120px;height:90px;object-fit:contain"><div><b style="color:#fff;font-size:15px"><%= it.shipHullAssetName %></b><div class="dim">"<%= it.playerPayloadShipName %>"</div></div></div>
      <div class="kv"><span>Shield / armor</span><span><%~ it.credits2 %> / <%~ it.credits22 %></span></div><div class="kv"><span>Speed / turn</span><span><%~ it.credits23 %> / <%~ it.credits24 %></span></div>
      <div class="kv"><span>Cargo</span><span><%~ it.playerPayloadCargoUsed %> / <%~ it.computedShipStatsCargo %> t</span></div><div class="kv"><span>Passenger seats</span><span><%~ it.playerPayloadMissions %> / <%~ it.computedShipStatsPassengerSeats %> occupied</span></div><div class="kv"><span>Outfit space</span><span><%~ it.computedShipStatsFree %> of <%~ it.computedShipStatsSpace %> free</span></div>
      <div class="kv"><span>Guns / turrets</span><span><%~ it.computedShipStatsGuns %>/<%~ it.computedShipStatsMaxGuns %> · <%~ it.computedShipStatsTurrets %>/<%~ it.computedShipStatsMaxTurrets %></span></div><div class="kv"><span>Fuel</span><span><%~ it.MathFloor %> jumps</span></div>