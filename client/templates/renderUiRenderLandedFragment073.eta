<tr><td><%= it.marketItemName %><%~ it.marketItemSellCap %><%~ it.marketItemFlash %></td><td class="<%~ it.marketItemPrice %>"><%~ it.credits %><%~ it.marketItemMoved %></td><td><%~ it.playerPayloadCargo %><%~ it.playerPayloadCargo2 %></td>
        <td style="text-align:right"><button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId %>" data-q="1"<%~ it.holdFree %>>BUY</button> <button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId2 %>" data-q="10"<%~ it.holdFree2 %>>+10</button> <button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId3 %>" data-q="<%~ it.MathMax %>" title="Fill your hold with what you can afford"<%~ it.MathMin %>>MAX</button> <button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId4 %>" data-q="-1">SELL</button> <button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId5 %>" data-q="-999">ALL</button><div class="trade-custom"><label>Amount <input class="trade-amount" data-c="<%~ it.marketItemId6 %>" type="number" required min="1" max="2147483647" step="1" inputmode="numeric" aria-label="<%= it.marketItemName2 %> trade amount in tons" value="<%= it.amountsGet %>"></label><button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId7 %>" data-custom="buy">BUY AMOUNT</button><button class="btn sm" data-act="trade" data-c="<%~ it.marketItemId8 %>" data-custom="sell">SELL AMOUNT</button></div><div class="trade-estimate small" data-trade-estimate="<%= it.marketItemId9 %>"><%~ it.tradeEstimateHtml %></div></td></tr><%~ it.gradeRows %>