{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "server/features.js",
    "server/feature-service.js",
    "server/fleetcmd.js",
    "server/contracts.js",
    "server/combat-assist.js",
    "server/message-registry.js",
    "shared/cargo-lots.js",
    "shared/cargo-contracts.js",
    "server/game.js",
    "server/frontier.js",
    "server/hangar.js",
    "server/coop.js"
  ]
}
