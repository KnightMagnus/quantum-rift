{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["server/**/*.ts", "client/**/*.ts", "shared/**/*.ts"]
}
