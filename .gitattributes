*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# README screenshots remain regular Git blobs, including on forks without LFS uploads.
docs/screenshots/** -filter -diff -merge -text

# Reproducible outfitter renders are small regular blobs; forks need no LFS upload.
client/assets/icons/*.png -filter -diff -merge -text
# Retired, unreferenced artwork keeps its existing LFS storage.
client/assets/icons/589.png filter=lfs diff=lfs merge=lfs -text

# Preserve original Earth art in ordinary clones even when remote LFS objects are unavailable.
client/assets/planets/earth*.webp -filter -diff -merge -text

# Original generated Gateway loop is shipped directly with the game.
client/assets/wormhole.png -filter -diff -merge -text

# Small reproducible lit-3D motherlodes ship directly without extra LFS fetches.
client/assets/objects/motherlode-*.webp -filter -diff -merge -text

# Original 3.1 title and synthesized score ship in ordinary clones.
client/assets/ui/title-31.png -filter -diff -merge -text
client/assets/sfx/music_login31.mp3 -filter -diff -merge -text

# Small reproducible cockpit cursors ship directly in ordinary clones.
client/assets/cursors/*.png -filter -diff -merge -text
