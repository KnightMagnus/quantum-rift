{
  "name": "quantum-rift",
  "version": "2.6",
  "description": "Quantum Rift: an online multiplayer space trading and combat game built from the EV Quantum assets.",
  "type": "module",
  "main": "server/main.js",
  "scripts": {
    "start": "node server/main.js",
    "test": "node test/bot.js",
    "typecheck": "tsc --noEmit",
    "test:features": "node test/features.js",
    "test:types": "node test/typecheck-contracts.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
