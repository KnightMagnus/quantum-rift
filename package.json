{
  "name": "quantum-rift",
  "version": "3.3.1",
  "description": "Quantum Rift: an online multiplayer space trading and combat game.",
  "type": "module",
  "main": "server/main.js",
  "scripts": {
    "start": "node tools/start.mjs",
    "test": "node test/bot.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "test:features": "node test/features.js",
    "test:types": "node test/typecheck-contracts.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && npm run build",
    "test:regression:unit": "node test/regression-runner.mjs unit",
    "test:regression:browser": "node test/regression-runner.mjs browser",
    "test:regression": "node test/regression-runner.mjs all",
    "build": "node tools/build.mjs",
    "prestart": "npm run build",
    "pretest:regression": "npm run build",
    "pretest:regression:unit": "npm run build",
    "pretest:regression:browser": "npm run build"
  },
  "engines": {
    "node": ">=27.0.0-0 <28"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
